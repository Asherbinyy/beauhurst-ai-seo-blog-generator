{
  "name": "beauhurst-seo-blog-generator",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "postinstall": "nuxt prepare --envName development",
    "build": "nuxt build",
    "build:test": "NUXT_TEST_MODE=1 nuxt build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env .output/server/index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "npm run build:test && playwright test",
    "screenshots": "npm run build:test && node scripts/capture-screenshots.mjs",
    "build:pages": "NUXT_SHOWCASE=1 nuxt generate --dotenv showcase/build.env",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "h3": "^1.15.4",
    "nuxt": "4.6.3",
    "papaparse": "5.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/papaparse": "5.5.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
